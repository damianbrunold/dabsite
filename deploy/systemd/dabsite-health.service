[Unit]
Description=dabsite health probe (restarts dabsite if /healthz fails)
After=dabsite.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/systemctl is-active --quiet dabsite.service
# Port/host come from /etc/dabsite/config.scm; two strikes before a restart.
ExecStart=/opt/dabsite/bin/healthcheck dabsite.service
