[Unit]
Description=dabsite scheme webapp
After=network-online.target postgresql.service
Wants=network-online.target
# If the health-check decides to restart us, that's fine — but if we
# restart-loop more than 5 times in 60s, give up so we don't burn CPU.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=dabsite
Group=dabsite
WorkingDirectory=/opt/dabsite/app
# Optional JAVA_OPTS (e.g. -Xmx512m); see README.Debian.
EnvironmentFile=-/etc/default/dabsite
ExecStart=/opt/dabsite/bin/scm bin/server.scm /etc/dabsite/config.scm

# Restart whenever the process exits, not only on failure. Combined with
# the daily restart timer this means the service is self-healing across
# OOMs, transient DB outages, and unexpected exceptions.
Restart=always
RestartSec=3s
# The JVM exits with 128+SIGTERM on a normal stop.
SuccessExitStatus=143

# Give the scheme HTTP server (graceful-stop-ms = 10s by default) time
# to drain in-flight requests before SIGKILL.
TimeoutStopSec=15s

# Logs go to journald — read with: journalctl -u dabsite -f
StandardOutput=journal
StandardError=journal

# --- hardening ---
# The only writable path is the data directory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0027
ReadWritePaths=/var/lib/dabsite

[Install]
WantedBy=multi-user.target
